# Get a free key at build.nvidia.com (click a model -> "Get API Key")
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Copy exact model IDs from each model's page on build.nvidia.com ("View Code")
PIP_REASONING_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
PIP_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
PIP_SAFETY_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
PIP_ASR_MODEL=nvidia/nemotron-asr-streaming